# The per-machine bindings of the data trees (data/README.md): links or
# directories, never tracked. Results live under data/exp_pro, keyed by run key.
/data/exp_raw
/data/exp_pro
/data/sims

# Local renderings (DrWatson plotsdir); the paper's assets are tracked under paper/figures/
/plots/

# Julia. Manifest.toml IS tracked (the package's own is not): it is the
# environment the results came from.
!Manifest.toml
Manifest-v*.toml
LocalPreferences.toml

# LaTeX build products
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
/paper/*.pdf

# Slurm
slurm-*.out
